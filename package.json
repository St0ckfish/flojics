{
  "name": "flojics",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "bun --cwd frontend oxlint --fix",
      "bun --cwd frontend prettier --write"
    ],
    "backend/**/*.php": [
      "backend/vendor/bin/pint"
    ]
  }
}
